{
  "schema_version": "1.0",
  "project": {
    "name": "TABANG",
    "expanded_name": "Transfusion Access, Blood Availability and Network Guidance",
    "description": "A centralized donor-management and blood-request research prototype for Digos City, Davao del Sur.",
    "institution": "Cor Jesu College, Inc.",
    "status": "base research prototype; simulated data; no live backend",
    "release": "v2.1.0",
    "release_commit": ""
  },
  "stack": {
    "framework": "Flutter 3.47.5",
    "language": "Dart 3.13.4",
    "ui": "Material 3",
    "maps": [
      "flutter_map",
      "latlong2"
    ],
    "files": [
      "file_picker"
    ],
    "auth": "prototype salted SHA-256 in-memory store",
    "backend": "none yet; Supabase blueprint prepared",
    "unused": [
      "firebase_core",
      "firebase_auth",
      "firebase.json",
      "google-services plugin"
    ]
  },
