  "known_gaps": [
    "no live Supabase backend",
    "no push notifications, voice calls, Google OAuth or production auth",
    "no profile-picture upload",
    "no clinical screening",
    "donor medical-history answers are not persisted",
    "Android release uses debug signing key",
    "Firebase packages are unused",
    "SQL starter not applied to a live project",
    "some RPC bodies still TODO"
  ],
  "hard_constraints": [
    "do not add Firebase",
    "do not use service_role in client",
    "do not expose PII",
    "do not expose unverified requests or their documents",
    "do not expose clinical notes on public request cards",
    "do not use length+1 IDs",
    "do not split multi-row workflows across client writes",
    "do not subscribe public screens to base tables with PII",
    "do not rebuild/publish APKs unless asked",
    "do not commit unrelated user changes",
    "do not claim tests pass without running them"
  ]
}
