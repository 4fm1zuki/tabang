    "design_rules": [
      "auth.users is the only credential store",
      "profiles owns role/status",
      "public screens read donor_directory, blood_units_public, request_public",
      "multi-row workflows are RPCs",
      "RLS on every table; deny by default",
      "no service_role in client",
      "Realtime is a notification, not initial load",
      "request documents in private Storage",
      "UUID + legacy_id; never length+1",
      "timestamptz in UTC, display Asia/Manila"
    ],
    "starter_status": "DDL is a starter; not executed against Supabase; some RPC bodies remain TODO"
  },
  "quality": {
    "tests": 213,
    "analyze": "clean at last check",
    "release_assets": [
