  "business_rules": {
    "eligibility": [
      "role donor",
      "verified account",
      "verified blood card",
      "not suspended",
      "blood type recorded",
      "age 18-65",
      "weight >= 50 kg",
      "available",
      "active within 30 days",
      "component allowed by staff",
      "outside component cooldown"
    ],
    "cooldowns_days": {
      "WHOLE_BLOOD": 84,
      "PACKED_RBC": 84,
      "PLATELETS": 14,
      "PLASMA": 28
    },
    "compatibility": [
      "red cells use standard ABO/Rh matrix",
      "plasma uses reverse ABO rule",
      "platelets use red-cell baseline"
    ],
    "request": [
      "starts pending review",
      "unverified submission is private to requester/staff; community board only shows verified open/matched",
      "3 required documents",
      "slot inside published blood-bank hours",
      "staff verify/reject",
      "donor responses only when open donor-network",
      "requester selects",
      "reciprocal human chat required before selection",
      "one active commitment per donor",
      "matched when enough selected",
      "staff/admin fulfil",
      "rejection releases holds/offers",
      "undo only from expected state"
    ],
    "inventory": [
      "expiry is effective",
      "barcode unique",
      "one active hold per bag",
      "hold is not a transfusion order",
      "expired cannot return to available",
      "removal ledger + restore"
    ],
    "drives": [
      "staff propose",
      "admin approves/rejects/cancels",
      "only approved public",
      "undo from expected state",
      "donor interest only"
    ],
    "warnings": [
      "max 3",
      "third suspends",
      "reinstatement clears ladder",
      "revoke steps down",
      "staff suspension separate"
    ],
    "privacy": [
      "alias public",
      "legal name/contact staff-only until bilateral reveal",
      "Donor #id on map",
      "block symmetric",
      "48h re-block cooldown",
      "chapter posts as organization",
      "staff room staff/admin only"
    ]
  },
